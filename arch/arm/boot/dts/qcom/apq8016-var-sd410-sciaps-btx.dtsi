#include "apq8016-var-sd410-sciaps-ngx-ampteck-dpp2.dtsi"
#include "apq8016-camera-sensor-var-sd410-sciaps-btx.dtsi"

&cci {

	actuator0: qcom,actuator@0 {
		status = "disabled";
	};

	eeprom0: qcom,eeprom@20 {
		status = "disabled";
	};

	qcom,camera@42 {
		status = "disabled";
	};
};

&soc {
	i2c@78b8000 { /* BLSP1 QUP4 */
        ie-battery@b {
            status = "disabled";
		};
        ie-charger@9 {
            status = "disabled";
		};
		battery@0x64 {
            status = "disabled";
		};
        ie-dual-battery@b {
            compatible = "nh2054-dual";
            reg = <0xb>;
            sciaps,support-shutdown = <1>;
            sciaps,shutdown-timer   = <15>;
			sciaps,capacity-low-thres-mAh = <0>; // calculated based on sciaps,capacity-low-thres
            sciaps,capacity-low-thres = <5>; // 0.5 %
            sciaps,voltage-crit-low-thres-mV = <11000>;
            sciaps,voltage-low-thres-mV = <14000>;
			status = "okay";
        };

        ltc1760-charger@9 {
            compatible = "ltc1760";
            reg = <0xa>;
			status = "okay";
        };
	};
};

